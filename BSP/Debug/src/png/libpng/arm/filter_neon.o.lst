 369              	/*
 370              	 * Added at libpng-1.2.8
 371              	 *
 372              	 * Ref MSDN: Private as priority over Special
 373              	 * VS_FF_PRIVATEBUILD File *was not* built using standard release
 374              	 * procedures. If this value is given, the StringFileInfo block must
 375              	 * contain a PrivateBuild string.
 376              	 *
 377              	 * VS_FF_SPECIALBUILD File *was* built by the original company using
 378              	 * standard release procedures but is a variation of the standard
 379              	 * file of the same version number. If this value is given, the
 380              	 * StringFileInfo block must contain a SpecialBuild string.
 381              	 */
 382              	
 383              	#ifdef PNG_USER_PRIVATEBUILD /* From pnglibconf.h */
 384              	#  define PNG_LIBPNG_BUILD_TYPE \
 385              	       (PNG_LIBPNG_BUILD_BASE_TYPE | PNG_LIBPNG_BUILD_PRIVATE)
 386              	#else
 387              	#  ifdef PNG_LIBPNG_SPECIALBUILD
 388              	#    define PNG_LIBPNG_BUILD_TYPE \
 389              	         (PNG_LIBPNG_BUILD_BASE_TYPE | PNG_LIBPNG_BUILD_SPECIAL)
 390              	#  else
 391              	#    define PNG_LIBPNG_BUILD_TYPE (PNG_LIBPNG_BUILD_BASE_TYPE)
 392              	#  endif
 384              	
 385              	/* pngconf.h does not set PNG_DLL_EXPORT unless it is required, so: */
 386              	#ifndef PNG_DLL_EXPORT
 387              	#  define PNG_DLL_EXPORT
 388              	#endif
 389              	
 390              	/* This is a global switch to set the compilation for an installed system
 391              	 * (a release build).  It can be set for testing debug builds to ensure that
 392              	 * they will compile when the build type is switched to RC or STABLE, the
 393              	 * default is just to use PNG_LIBPNG_BUILD_BASE_TYPE.  Set this in CPPFLAGS
 394              	 * with either:
 395              	 *
 396              	 *   -DPNG_RELEASE_BUILD Turns on the release compile path
 397              	 *   -DPNG_RELEASE_BUILD=0 Turns it off
 398              	 * or in your pngusr.h with
 399              	 *   #define PNG_RELEASE_BUILD=1 Turns on the release compile path
 400              	 *   #define PNG_RELEASE_BUILD=0 Turns it off
 401              	 */
 402              	#ifndef PNG_RELEASE_BUILD
 403              	#  define PNG_RELEASE_BUILD (PNG_LIBPNG_BUILD_BASE_TYPE >= PNG_LIBPNG_BUILD_RC)
 404              	#endif
 405              	
 406              	/* SECURITY and SAFETY:
 407              	 *
 408              	 * libpng is built with support for internal limits on image dimensions and
 409              	 * memory usage.  These are documented in scripts/pnglibconf.dfa of the
 410              	 * source and recorded in the machine generated header file pnglibconf.h.
 411              	 */
 412              	
 413              	/* If you are running on a machine where you cannot allocate more
 414              	 * than 64K of memory at once, uncomment this.  While libpng will not
 415              	 * normally need that much memory in a chunk (unless you load up a very
 416              	 * large file), zlib needs to know how big of a chunk it can use, and
 417              	 * libpng thus makes sure to check any memory allocation to verify it
 418              	 * will fit into memory.
 419              	 *
 420              	 * zlib provides 'MAXSEG_64K' which, if defined, indicates the
 421              	 * same limit and pngconf.h (already included) sets the limit
 422              	 * if certain operating systems are detected.
 423              	 */
 424              	#if defined(MAXSEG_64K) && !defined(PNG_MAX_MALLOC_64K)
 425              	#  define PNG_MAX_MALLOC_64K
 426              	#endif
 427              	
 428              	#ifndef PNG_UNUSED
 429              	/* Unused formal parameter warnings are silenced using the following macro
 430              	 * which is expected to have no bad effects on performance (optimizing
 431              	 * compilers will probably remove it entirely).  Note that if you replace
 432              	 * it with something other than whitespace, you must include the terminating
 433              	 * semicolon.
 434              	 */
 435              	#  define PNG_UNUSED(param) (void)param;
 436              	#endif
 437              	
 438              	/* Just a little check that someone hasn't tried to define something
 439              	 * contradictory.
 440              	 */
 441              	#if (PNG_ZBUF_SIZE > 65536L) && defined(PNG_MAX_MALLOC_64K)
 442              	#  undef PNG_ZBUF_SIZE
 443              	#  define PNG_ZBUF_SIZE 65536L
 444              	#endif
 445              	
 446              	/* If warnings or errors are turned off the code is disabled or redirected here.
 447              	 * From 1.5.4 functions have been added to allow very limited formatting of
 448              	 * error and warning messages - this code will also be disabled here.
 449              	 */
 450              	#ifdef PNG_WARNINGS_SUPPORTED
 451              	#  define PNG_WARNING_PARAMETERS(p) png_warning_parameters p;
 452              	#else
 453              	#  define png_warning_parameter(p,number,string) ((void)0)
 454              	#  define png_warning_parameter_unsigned(p,number,format,value) ((void)0)
 455              	#  define png_warning_parameter_signed(p,number,format,value) ((void)0)
 456              	#  define png_formatted_warning(pp,p,message) ((void)(pp))
 457              	#  define PNG_WARNING_PARAMETERS(p)
 458              	#endif
 459              	#ifndef PNG_ERROR_TEXT_SUPPORTED
 460              	#  define png_fixed_error(s1,s2) png_err(s1)
 461              	#endif
 462              	
 463              	/* Some fixed point APIs are still required even if not exported because
 464              	 * they get used by the corresponding floating point APIs.  This magic
 465              	 * deals with this:
 466              	 */
 467              	#ifdef PNG_FIXED_POINT_SUPPORTED
 468              	#  define PNGFAPI PNGAPI
 469              	#else
 470              	#  define PNGFAPI /* PRIVATE */
 471              	#endif
 472              	
 473              	#ifndef PNG_VERSION_INFO_ONLY
 474              	/* Other defines specific to compilers can go here.  Try to keep
 475              	 * them inside an appropriate ifdef/endif pair for portability.
 476              	 */
 477              	
 478              	/* C allows up-casts from (void*) to any pointer and (const void*) to any
 479              	 * pointer to a const object.  C++ regards this as a type error and requires an
 480              	 * explicit, static, cast and provides the static_cast<> rune to ensure that
 481              	 * const is not cast away.
 482              	 */
 483              	#ifdef __cplusplus
 484              	#  define png_voidcast(type, value) static_cast<type>(value)
 485              	#  define png_constcast(type, value) const_cast<type>(value)
 486              	#  define png_aligncast(type, value) \
 487              	   static_cast<type>(static_cast<void*>(value))
 488              	#  define png_aligncastconst(type, value) \
 489              	   static_cast<type>(static_cast<const void*>(value))
 490              	#else
 491              	#  define png_voidcast(type, value) (value)
 492              	#  ifdef _WIN64
 493              	#     ifdef __GNUC__
 494              	         typedef unsigned long long png_ptruint;
 495              	#     else
 496              	         typedef unsigned __int64 png_ptruint;
 497              	#     endif
 498              	#  else
 499              	      typedef unsigned long png_ptruint;
 500              	#  endif
 501              	#  define png_constcast(type, value) ((type)(png_ptruint)(const void*)(value))
 502              	#  define png_aligncast(type, value) ((void*)(value))
 503              	#  define png_aligncastconst(type, value) ((const void*)(value))
 504              	#endif /* __cplusplus */
 505              	
 506              	#if defined(PNG_FLOATING_POINT_SUPPORTED) ||\
 507              	    defined(PNG_FLOATING_ARITHMETIC_SUPPORTED)
 508              	   /* png.c requires the following ANSI-C constants if the conversion of
 509              	    * floating point to ASCII is implemented therein:
 510              	    *
 511              	    *  DBL_DIG  Maximum number of decimal digits (can be set to any constant)
 512              	    *  DBL_MIN  Smallest normalized fp number (can be set to an arbitrary value)
 513              	    *  DBL_MAX  Maximum floating point number (can be set to an arbitrary value)
 514              	    */
 515              	#  include <float.h>
 516              	
 517              	#  if (defined(__MWERKS__) && defined(macintosh)) || defined(applec) || \
 518              	    defined(THINK_C) || defined(__SC__) || defined(TARGET_OS_MAC)
 519              	   /* We need to check that <math.h> hasn't already been included earlier
 520              	    * as it seems it doesn't agree with <fp.h>, yet we should really use
 521              	    * <fp.h> if possible.
 522              	    */
 523              	#    if !defined(__MATH_H__) && !defined(__MATH_H) && !defined(__cmath__)
 524              	#      include <fp.h>
 525              	#    endif
 526              	#  else
 527              	#    include <math.h>
 528              	#  endif
 529              	#  if defined(_AMIGA) && defined(__SASC) && defined(_M68881)
 530              	   /* Amiga SAS/C: We must include builtin FPU functions when compiling using
 531              	    * MATH=68881
 532              	    */
 533              	#    include <m68881.h>
 534              	#  endif
 535              	#endif
 536              	
 537              	/* This provides the non-ANSI (far) memory allocation routines. */
 538              	#if defined(__TURBOC__) && defined(__MSDOS__)
 539              	#  include <mem.h>
 540              	#  include <alloc.h>
 541              	#endif
 542              	
 543              	#if defined(WIN32) || defined(_Windows) || defined(_WINDOWS) || \
 544              	    defined(_WIN32) || defined(__WIN32__)
 545              	#  include <windows.h>  /* defines _WINDOWS_ macro */
 546              	#endif
 547              	#endif /* PNG_VERSION_INFO_ONLY */
