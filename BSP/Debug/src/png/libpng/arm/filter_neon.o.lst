 719              	/* Save typing and make code easier to understand */
 720              	
 721              	#define PNG_COLOR_DIST(c1, c2) (abs((int)((c1).red) - (int)((c2).red)) + \
 722              	   abs((int)((c1).green) - (int)((c2).green)) + \
 723              	   abs((int)((c1).blue) - (int)((c2).blue)))
 724              	
 725              	/* Added to libpng-1.6.0: scale a 16-bit value in the range 0..65535 to 0..255
 726              	 * by dividing by 257 *with rounding*.  This macro is exact for the given range.
 727              	 * See the discourse in pngrtran.c png_do_scale_16_to_8.  The values in the
 728              	 * macro were established by experiment (modifying the added value).  The macro
 729              	 * has a second variant that takes a value already scaled by 255 and divides by
 730              	 * 65535 - this has a maximum error of .502.  Over the range 0..65535*65535 it
 731              	 * only gives off-by-one errors and only for 0.5% (1 in 200) of the values.
 732              	 */
 733              	#define PNG_DIV65535(v24) (((v24) + 32895) >> 16)
 734              	#define PNG_DIV257(v16) PNG_DIV65535((png_uint_32)(v16) * 255)
 735              	
 736              	/* Added to libpng-1.2.6 JB */
 737              	#define PNG_ROWBYTES(pixel_bits, width) \
 738              	    ((pixel_bits) >= 8 ? \
 739              	    ((size_t)(width) * (((size_t)(pixel_bits)) >> 3)) : \
 740              	    (( ((size_t)(width) * ((size_t)(pixel_bits))) + 7) >> 3) )
 741              	
 742              	/* This returns the number of trailing bits in the last byte of a row, 0 if the
 743              	 * last byte is completely full of pixels.  It is, in principle, (pixel_bits x
 744              	 * width) % 8, but that would overflow for large 'width'.  The second macro is
 745              	 * the same except that it returns the number of unused bits in the last byte;
 746              	 * (8-TRAILBITS), but 0 when TRAILBITS is 0.
 747              	 *
 748              	 * NOTE: these macros are intended to be self-evidently correct and never
 749              	 * overflow on the assumption that pixel_bits is in the range 0..255.  The
 750              	 * arguments are evaluated only once and they can be signed (e.g. as a result of
 751              	 * the integral promotions).  The result of the expression always has type
 752              	 * (png_uint_32), however the compiler always knows it is in the range 0..7.
 753              	 */
 754              	#define PNG_TRAILBITS(pixel_bits, width) \
 755              	    (((pixel_bits) * ((width) % (png_uint_32)8)) % 8)
 756              	
 757              	#define PNG_PADBITS(pixel_bits, width) \
 758              	    ((8 - PNG_TRAILBITS(pixel_bits, width)) % 8)
 759              	
 760              	/* PNG_OUT_OF_RANGE returns true if value is outside the range
 761              	 * ideal-delta..ideal+delta.  Each argument is evaluated twice.
 762              	 * "ideal" and "delta" should be constants, normally simple
 763              	 * integers, "value" a variable. Added to libpng-1.2.6 JB
 764              	 */
 765              	#define PNG_OUT_OF_RANGE(value, ideal, delta) \
 766              	   ( (value) < (ideal)-(delta) || (value) > (ideal)+(delta) )
 767              	
 768              	/* Conversions between fixed and floating point, only defined if
 769              	 * required (to make sure the code doesn't accidentally use float
 770              	 * when it is supposedly disabled.)
 771              	 */
 772              	#ifdef PNG_FLOATING_POINT_SUPPORTED
 773              	/* The floating point conversion can't overflow, though it can and
 774              	 * does lose accuracy relative to the original fixed point value.
 775              	 * In practice this doesn't matter because png_fixed_point only
 776              	 * stores numbers with very low precision.  The png_ptr and s
 777              	 * arguments are unused by default but are there in case error
 778              	 * checking becomes a requirement.
 779              	 */
 780              	#define png_float(png_ptr, fixed, s) (.00001 * (fixed))
 781              	
 782              	/* The fixed point conversion performs range checking and evaluates
 783              	 * its argument multiple times, so must be used with care.  The
 784              	 * range checking uses the PNG specification values for a signed
 785              	 * 32-bit fixed point value except that the values are deliberately
 786              	 * rounded-to-zero to an integral value - 21474 (21474.83 is roughly
 787              	 * (2^31-1) * 100000). 's' is a string that describes the value being
 788              	 * converted.
 789              	 *
 790              	 * NOTE: this macro will raise a png_error if the range check fails,
 791              	 * therefore it is normally only appropriate to use this on values
 792              	 * that come from API calls or other sources where an out of range
 793              	 * error indicates a programming error, not a data error!
 794              	 *
 795              	 * NOTE: by default this is off - the macro is not used - because the
 796              	 * function call saves a lot of code.
 797              	 */
 798              	#ifdef PNG_FIXED_POINT_MACRO_SUPPORTED
 799              	#define png_fixed(png_ptr, fp, s) ((fp) <= 21474 && (fp) >= -21474 ?\
 800              	    ((png_fixed_point)(100000 * (fp))) : (png_fixed_error(png_ptr, s),0))
 801              	#endif
 802              	/* else the corresponding function is defined below, inside the scope of the
 803              	 * cplusplus test.
 804              	 */
 805              	#endif
 806              	
 807              	/* Constants for known chunk types.  If you need to add a chunk, define the name
 808              	 * here.  For historical reasons these constants have the form png_<name>; i.e.
 809              	 * the prefix is lower case.  Please use decimal values as the parameters to
 810              	 * match the ISO PNG specification and to avoid relying on the C locale
 811              	 * interpretation of character values.
 812              	 *
 813              	 * Prior to 1.5.6 these constants were strings, as of 1.5.6 png_uint_32 values
 814              	 * are computed and a new macro (PNG_STRING_FROM_CHUNK) added to allow a string
 815              	 * to be generated if required.
 816              	 *
 817              	 * PNG_32b correctly produces a value shifted by up to 24 bits, even on
 818              	 * architectures where (int) is only 16 bits.
 819              	 */
 820              	#define PNG_32b(b,s) ((png_uint_32)(b) << (s))
 821              	#define PNG_U32(b1,b2,b3,b4) \
 822              	   (PNG_32b(b1,24) | PNG_32b(b2,16) | PNG_32b(b3,8) | PNG_32b(b4,0))
 823              	
 824              	/* Constants for known chunk types.
 825              	 *
 826              	 * MAINTAINERS: If you need to add a chunk, define the name here.
 827              	 * For historical reasons these constants have the form png_<name>; i.e.
 828              	 * the prefix is lower case.  Please use decimal values as the parameters to
 829              	 * match the ISO PNG specification and to avoid relying on the C locale
 830              	 * interpretation of character values.  Please keep the list sorted.
 831              	 *
 832              	 * Notice that PNG_U32 is used to define a 32-bit value for the 4 byte chunk
 833              	 * type.  In fact the specification does not express chunk types this way,
 834              	 * however using a 32-bit value means that the chunk type can be read from the
 835              	 * stream using exactly the same code as used for a 32-bit unsigned value and
 836              	 * can be examined far more efficiently (using one arithmetic compare).
 837              	 *
 838              	 * Prior to 1.5.6 the chunk type constants were expressed as C strings.  The
 839              	 * libpng API still uses strings for 'unknown' chunks and a macro,
 840              	 * PNG_STRING_FROM_CHUNK, allows a string to be generated if required.  Notice
 841              	 * that for portable code numeric values must still be used; the string "IHDR"
 842              	 * is not portable and neither is PNG_U32('I', 'H', 'D', 'R').
 843              	 *
 844              	 * In 1.7.0 the definitions will be made public in png.h to avoid having to
 845              	 * duplicate the same definitions in application code.
 846              	 */
 847              	#define png_IDAT PNG_U32( 73,  68,  65,  84)
 848              	#define png_IEND PNG_U32( 73,  69,  78,  68)
 849              	#define png_IHDR PNG_U32( 73,  72,  68,  82)
 850              	#define png_PLTE PNG_U32( 80,  76,  84,  69)
 851              	#define png_bKGD PNG_U32( 98,  75,  71,  68)
 852              	#define png_cHRM PNG_U32( 99,  72,  82,  77)
 853              	#define png_eXIf PNG_U32(101,  88,  73, 102) /* registered July 2017 */
 854              	#define png_fRAc PNG_U32(102,  82,  65,  99) /* registered, not defined */
 855              	#define png_gAMA PNG_U32(103,  65,  77,  65)
 856              	#define png_gIFg PNG_U32(103,  73,  70, 103)
 857              	#define png_gIFt PNG_U32(103,  73,  70, 116) /* deprecated */
 858              	#define png_gIFx PNG_U32(103,  73,  70, 120)
 859              	#define png_hIST PNG_U32(104,  73,  83,  84)
 860              	#define png_iCCP PNG_U32(105,  67,  67,  80)
 861              	#define png_iTXt PNG_U32(105,  84,  88, 116)
 862              	#define png_oFFs PNG_U32(111,  70,  70, 115)
 863              	#define png_pCAL PNG_U32(112,  67,  65,  76)
 864              	#define png_pHYs PNG_U32(112,  72,  89, 115)
 865              	#define png_sBIT PNG_U32(115,  66,  73,  84)
 866              	#define png_sCAL PNG_U32(115,  67,  65,  76)
 867              	#define png_sPLT PNG_U32(115,  80,  76,  84)
 868              	#define png_sRGB PNG_U32(115,  82,  71,  66)
 869              	#define png_sTER PNG_U32(115,  84,  69,  82)
 870              	#define png_tEXt PNG_U32(116,  69,  88, 116)
 871              	#define png_tIME PNG_U32(116,  73,  77,  69)
 872              	#define png_tRNS PNG_U32(116,  82,  78,  83)
 873              	#define png_zTXt PNG_U32(122,  84,  88, 116)
 874              	
 875              	/* The following will work on (signed char*) strings, whereas the get_uint_32
 876              	 * macro will fail on top-bit-set values because of the sign extension.
 877              	 */
 878              	#define PNG_CHUNK_FROM_STRING(s)\
 879              	   PNG_U32(0xff & (s)[0], 0xff & (s)[1], 0xff & (s)[2], 0xff & (s)[3])
 880              	
 881              	/* This uses (char), not (png_byte) to avoid warnings on systems where (char) is
 882              	 * signed and the argument is a (char[])  This macro will fail miserably on
 883              	 * systems where (char) is more than 8 bits.
 884              	 */
 885              	#define PNG_STRING_FROM_CHUNK(s,c)\
 886              	   (void)(((char*)(s))[0]=(char)(((c)>>24) & 0xff), \
 887              	   ((char*)(s))[1]=(char)(((c)>>16) & 0xff),\
 888              	   ((char*)(s))[2]=(char)(((c)>>8) & 0xff), \
 889              	   ((char*)(s))[3]=(char)((c & 0xff)))
 890              	
 891              	/* Do the same but terminate with a null character. */
 892              	#define PNG_CSTRING_FROM_CHUNK(s,c)\
 893              	   (void)(PNG_STRING_FROM_CHUNK(s,c), ((char*)(s))[4] = 0)
 894              	
 895              	/* Test on flag values as defined in the spec (section 5.4): */
 896              	#define PNG_CHUNK_ANCILLARY(c)   (1 & ((c) >> 29))
 897              	#define PNG_CHUNK_CRITICAL(c)     (!PNG_CHUNK_ANCILLARY(c))
 898              	#define PNG_CHUNK_PRIVATE(c)      (1 & ((c) >> 21))
 899              	#define PNG_CHUNK_RESERVED(c)     (1 & ((c) >> 13))
 900              	#define PNG_CHUNK_SAFE_TO_COPY(c) (1 & ((c) >>  5))
