 549              	/* Moved here around 1.5.0beta36 from pngconf.h */
 550              	/* Users may want to use these so they are not private.  Any library
 551              	 * functions that are passed far data must be model-independent.
 552              	 */
 553              	
 554              	/* Memory model/platform independent fns */
 555              	#ifndef PNG_ABORT
 556              	#  ifdef _WINDOWS_
 557              	#    define PNG_ABORT() ExitProcess(0)
 558              	#  elif defined(PNG_RZ)
 559              	#    define PNG_ABORT() while(1)
 560              	#  else
 561              	#    define PNG_ABORT() abort()
 562              	#  endif
 563              	#endif
 564              	
 565              	/* These macros may need to be architecture dependent. */
 566              	#define PNG_ALIGN_NONE   0 /* do not use data alignment */
 567              	#define PNG_ALIGN_ALWAYS 1 /* assume unaligned accesses are OK */
 568              	#ifdef offsetof
 569              	#  define PNG_ALIGN_OFFSET 2 /* use offsetof to determine alignment */
 570              	#else
 571              	#  define PNG_ALIGN_OFFSET -1 /* prevent the use of this */
 572              	#endif
 573              	#define PNG_ALIGN_SIZE   3 /* use sizeof to determine alignment */
 574              	
 575              	#ifndef PNG_ALIGN_TYPE
 576              	   /* Default to using aligned access optimizations and requiring alignment to a
 577              	    * multiple of the data type size.  Override in a compiler specific fashion
 578              	    * if necessary by inserting tests here:
 579              	    */
 580              	#  define PNG_ALIGN_TYPE PNG_ALIGN_SIZE
 581              	#endif
 582              	
 583              	#if PNG_ALIGN_TYPE == PNG_ALIGN_SIZE
 584              	   /* This is used because in some compiler implementations non-aligned
 585              	    * structure members are supported, so the offsetof approach below fails.
 586              	    * Set PNG_ALIGN_SIZE=0 for compiler combinations where unaligned access
 587              	    * is good for performance.  Do not do this unless you have tested the result
 588              	    * and understand it.
 589              	    */
 590              	#  define png_alignof(type) (sizeof (type))
 591              	#else
 592              	#  if PNG_ALIGN_TYPE == PNG_ALIGN_OFFSET
 593              	#     define png_alignof(type) offsetof(struct{char c; type t;}, t)
 594              	#  else
 595              	#     if PNG_ALIGN_TYPE == PNG_ALIGN_ALWAYS
 596              	#        define png_alignof(type) (1)
 597              	#     endif
 598              	      /* Else leave png_alignof undefined to prevent use thereof */
 599              	#  endif
 600              	#endif
 601              	
 602              	/* This implicitly assumes alignment is always to a power of 2. */
 603              	#ifdef png_alignof
 604              	#  define png_isaligned(ptr, type)\
 605              	   (((type)((const char*)ptr-(const char*)0) & \
 606              	   (type)(png_alignof(type)-1)) == 0)
 607              	#else
 608              	#  define png_isaligned(ptr, type) 0
 609              	#endif
 610              	
 611              	/* End of memory model/platform independent support */
 612              	/* End of 1.5.0beta36 move from pngconf.h */
