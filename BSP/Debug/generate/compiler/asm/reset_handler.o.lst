  23              	@/*******************************************************************************
  24              	@* File Name   : reset_handler.asm
  25              	@* Description : Reset handler
  26              	@*******************************************************************************/
  27              	
  28              	
  29              	@ Standard definitions of mode bits and interrupt (I & F) flags in PSRs
  30              	    .EQU    USR_MODE,   0x10
  31              	    .EQU    FIQ_MODE,   0x11
  32              	    .EQU    IRQ_MODE,   0x12
  33              	    .EQU    SVC_MODE,   0x13
  34              	    .EQU    ABT_MODE,   0x17
  35              	    .EQU    UND_MODE,   0x1b
  36              	    .EQU    SYS_MODE,   0x1f
  37              	    .EQU    Thum_bit,   0x20            @ CPSR/SPSR Thumb bit
  38              	
  39              	@==================================================================
  40              	@ Entry point for the Reset handler
  41              	@==================================================================
  42              	    .section    RESET_HANDLER, #execinstr
  43              	    .arm
  44              	
  45              	    .extern  __sys_stack_end     @ Linker symbol from scatter file
  46              	    .extern  __irq_stack_end     @ Linker symbol from scatter file
  47              	    .extern  __fiq_stack_end     @ Linker symbol from scatter file
  48              	    .extern  __svc_stack_end     @ Linker symbol from scatter file
  49              	 
  50              	    .weak    DTBL_F
  51              	    .weak    BTBL_F
  52              	    .weak    DTBL_F2
  53              	    .weak    BTBL_F2
  54              	    .weak    DTBL
  55              	    .weak    BTBL
  56              	
  57              	    .extern  vector_table
  58              	    .extern  R_SC_HardwareSetup
  59              	    .extern  R_MMU_Init
  60              	    .extern  Enable_VFP
  61              	    .extern  INITSCT
  62              	    .extern  __libc_init_array
  63              	    .extern  main
  64              	    .extern  exit
  65              	    .extern  r_memclk_setup
  66              	    .extern  vector_table2
  67              	
  68              	    .global  reset_handler
  69              	    .global  undefined_handler
  70              	    .global  svc_handler
  71              	    .global  prefetch_handler
  72              	    .global  abort_handler
  73              	    .global  reserved_handler
  74              	
  75              	@******************************************************************************
  76              	@ Function Name : reset_handler
  77              	@ Description   : This function is the assembler function executed after reset
  78              	@               : cancellation. After initial setting for the stack pointer or
  79              	@               : the MMU and reset cancellation, executes initial setting for
  80              	@               : the minimum required peripheral functions. Calls the main
  81              	@               : function to execute.
  82              	@******************************************************************************
  83              	reset_handler:
  84              	
  85              	@===================================================================
  86              	@ Clock Setting
  87              	@ Set FRQCR.IFC : CPU Clock 1/8(132MHz) -> 1/2(528MHz)
  88              	@===================================================================
  89              	    @; Set standby_mode_en of REG15 Power Control Register
  90 0000 6C019FE5 	    LDR  r0, =0x1F003F80            @;; Address(REG15 Power Control Register)
  91 0004 0110A0E3 	    LDR  r1, =0x00000001            @;; Setting Value (REG15 Power Control Register)
  92 0008 001080E5 	    STR  r1, [r0]                   @;; REG15_POWER_CTRL = 0x00000001
  93 000c 001090E5 	    LDR  r1, [r0]                   @;; dummy read
  94              	
  95              	    @; FRQCR = 0x0012 PLL(x88), I:B:P1:P0 = 22:5.5:2.75:1.375
  96 0010 60019FE5 	    LDR  r0, =0xFCFE0010            @;; Address(FRQCR Register)
  97 0014 1210A0E3 	    LDR  r1, =0x0012                @;; Setting Value(FRQCR Register)
  98 0018 B010C0E1 	    STRH r1, [r0]                   @;; FRQCR = 0x0012
  99 001c B000D0E1 	    LDRH r0, [r0]                   @;; dummy read
 100              	
 101              	@===================================================================
 102              	@ Set Vector Base Address Register (VBAR) to point to initializer routine
 103              	@===================================================================
 104 0020 54019FE5 	    LDR r0, =vector_table
 105 0024 100F0CEE 	    MCR p15, 0, r0, c12, c0, 0
 106              	
 107              	@==================================================================
 108              	@ Disable cache and MMU in case it was left enabled from an earlier run
 109              	@ This does not need to be done from a cold reset
 110              	@==================================================================
 111 0028 100F11EE 	    MRC  p15, 0, r0, c1, c0, 0      @;; Read CP15 System Control register (SCTLR)
 112 002c 020AC0E3 	    BIC  r0, r0, #(0x1 << 13)       @;; Set Low Vectors
 113 0030 010AC0E3 	    BIC  r0, r0, #(0x1 << 12)       @;; Clear I bit 12 to disable I Cache
 114 0034 0400C0E3 	    BIC  r0, r0, #(0x1 <<  2)       @;; Clear C bit  2 to disable D Cache
 115 0038 0100C0E3 	    BIC  r0, r0, #0x1               @;; Clear M bit  0 to disable MMU
 116 003c 100F01EE 	    MCR  p15, 0, r0, c1, c0, 0      @;; Write value back to CP15 System Control register
 117              	
 118              	@==================================================================
 119              	@ Setting up Stack Area (SVC/IRQ/FIQ/ABT/SYS)
 120              	@==================================================================
 121 0040 130002F1 	    CPS  #SVC_MODE                  @;; SVC Mode
 122 0044 34D19FE5 	    LDR  sp, =__svc_stack_end
 123              	
 124 0048 120002F1 	    CPS  #IRQ_MODE                  @;; IRQ Mode
 125 004c 30D19FE5 	    LDR  sp, =__irq_stack_end
 126              	
 127 0050 110002F1 	    CPS  #FIQ_MODE                  @;; FIQ Mode
 128 0054 2CD19FE5 	    LDR  sp, =__fiq_stack_end
 129              	
 130 0058 1F0002F1 	    CPS  #SYS_MODE                  @;; SYS Mode
 131 005c 28D19FE5 	    LDR  sp, =__sys_stack_end
 132              	
 133              	#if defined(__ARM_FP) || defined(__ARM_NEON_FP)
 134              	@===================================================================
 135              	@ Enable the vfp
 136              	@===================================================================
 137 0060 28C19FE5 	    LDR  r12,=Enable_VFP            @;; Save this in register for possible long jump
 138 0064 3CFF2FE1 	    BLX  r12                        @;; Call to enable the vfp
 139              	#endif
 140              	
 141              	@==================================================================
 142              	@ Section initialize for r_memclk_setup
 143              	@==================================================================
 144 0068 24019FE5 	    LDR  r0, =DTBL_F2                @;; ROM to RAM table for r_memclk_setup
 145 006c 24119FE5 	    LDR  r1, =BTBL_F2                @;; RAM zero fill table for r_memclk_setup
 146 0070 24C19FE5 	    LDR  r12,=INITSCT                @;; Function for Initialize sections
 147 0074 3CFF2FE1 	    BLX  r12                         @;; Call
 148              	
 149              	@==================================================================
 150              	@ setting memory clock before R_SC_HardwareSetup function
 151              	@==================================================================
 152 0078 20C19FE5 	    LDR  r12,=r_memclk_setup       @;; Save this in register for possible long jump
 153 007c 3CFF2FE1 	    BLX  r12                       @;; Hardware Initialize
 154              	
 155              	@==================================================================
 156              	@ Section initialize for R_SC_HardwareSetup
 157              	@==================================================================
 158 0080 1C019FE5 	    LDR  r0, =DTBL_F                @;; ROM to RAM table for R_SC_HardwareSetup
 159 0084 1C119FE5 	    LDR  r1, =BTBL_F                @;; RAM zero fill table for R_SC_HardwareSetup
 160 0088 0CC19FE5 	    LDR  r12,=INITSCT               @;; Function for Initialize sections
 161 008c 3CFF2FE1 	    BLX  r12                        @;; Call
 162              	
 163              	@==================================================================
 164              	@ Hardware initialized earlier than section-init
 165              	@==================================================================
 166 0090 14C19FE5 	    LDR  r12,=R_SC_HardwareSetup    @;; Save this in register for possible long jump
 167 0094 3CFF2FE1 	    BLX  r12                        @;; Hardware Initialize
 168              	
 169              	@==================================================================
 170              	@ Initialize MMU translation table
 171              	@==================================================================
 172 0098 10C19FE5 	    LDR  r12,=R_MMU_Init            @;; Save this in register for possible long jump
 173 009c 3CFF2FE1 	    BLX  r12                        @;; Initialize MMU
 174              	
 175              	@==================================================================
 176              	@ TLB maintenance, Invalidate Data and Instruction TLBs
 177              	@==================================================================
 178 00a0 0000A0E3 	    MOV  r0,#0
 179 00a4 170F08EE 	    MCR  p15, 0, r0, c8, c7, 0      @;; Cortex-A9 I-TLB and D-TLB invalidation (TLBIALL)
 180              	
 181              	@===================================================================
 182              	@ Invalidate instruction cache, also flushes BTAC
 183              	@===================================================================
 184 00a8 0000A0E3 	    MOV  r0, #0                     @;; SBZ
 185 00ac 150F07EE 	    MCR  p15, 0, r0, c7, c5, 0      @;; ICIALLU - Invalidate entire I Cache, and flushes branch tar
 186              	
 187              	@==================================================================
 188              	@ Cache Invalidation code for Cortex-A9
 189              	@==================================================================
 190              	    @;; Invalidate L1 Instruction Cache
 191 00b0 300F30EE 	    MRC  p15, 1, r0, c0, c0, 1      @;; Read Cache Level ID Register (CLIDR)
 192 00b4 030010E3 	    TST  r0, #0x3                   @;; Harvard Cache?
 193 00b8 0000A0E3 	    MOV  r0, #0
 194 00bc 150F071E 	    MCRNE   p15, 0, r0, c7, c5, 0   @;; Invalidate Instruction Cache
 195              	
 196              	    @;; Invalidate Data/Unified Caches
 197 00c0 300F30EE 	    MRC  p15, 1, r0, c0, c0, 1      @;; Read CLIDR
 198 00c4 073410E2 	    ANDS r3, r0, #0x07000000        @;; Extract coherency level
 199 00c8 A33BA0E1 	    MOV  r3, r3, LSR #23            @;; Total cache levels << 1
 200 00cc 1A00000A 	    BEQ  Finished                   @;; If 0, no need to clean
 201              	
 202 00d0 00A0A0E3 	    MOV  r10, #0                    @;; R10 holds current cache level << 1
 203              	Loop1:
 204 00d4 AA208AE0 	    ADD  r2, r10, r10, LSR #1       @;; R2 holds cache "Set" position
 205 00d8 3012A0E1 	    MOV  r1, r0, LSR r2             @;; Bottom 3 bits are the Cache-type for this level
 206 00dc 071001E2 	    AND  r1, r1, #7                 @;; Isolate those lower 3 bits
 207 00e0 020051E3 	    CMP  r1, #2
 208 00e4 110000BA 	    BLT  Skip                       @;; No cache or only instruction cache at this level
 209              	
 210 00e8 10AF40EE 	    MCR  p15, 2, r10, c0, c0, 0     @;; Write the Cache Size selection register (CSSELR)
 211 00ec 6FF07FF5 	    ISB                             @;; ISB to sync the change to the CacheSizeID reg
 212 00f0 101F30EE 	    MRC  p15, 1, r1, c0, c0, 0      @;; Reads current Cache Size ID register (CCSIDR)
 213 00f4 072001E2 	    AND  r2, r1, #7                 @;; Extract the line length field
 214 00f8 042082E2 	    ADD  r2, r2, #4                 @;; Add 4 for the line length offset (log2 16 bytes)
 215 00fc B0409FE5 	    LDR  r4, =0x3FF
 216 0100 A14114E0 	    ANDS r4, r4, r1, LSR #3         @;; R4 is the max number on the way size (right aligned)
 217 0104 145F6FE1 	    CLZ  r5, r4                     @;; R5 is the bit position of the way size increment
 218 0108 A8709FE5 	    LDR  r7, =0x7FFF
 219 010c A17617E0 	    ANDS r7, r7, r1, LSR #13        @;; R7 is the max number of the index size (right aligned)
 220              	Loop2:
 221 0110 0490A0E1 	    MOV  r9, r4                     @;; R9 working copy of the max way size (right aligned)
 222              	
 223              	Loop3:
 224 0114 19B58AE1 	    ORR  r11, r10, r9, LSL r5       @;; Factor in the Way number and cache number into R11
 225 0118 17B28BE1 	    ORR  r11, r11, r7, LSL r2       @;; Factor in the Set number
 226 011c 56BF07EE 	    MCR  p15, 0, r11, c7, c6, 2     @;; Invalidate by Set/Way (DCISW)
 227 0120 019059E2 	    SUBS r9, r9, #1                 @;; Decrement the Way number
 228 0124 FAFFFFAA 	    BGE  Loop3
 229 0128 017057E2 	    SUBS r7, r7, #1                 @;; Decrement the Set number
 230 012c F7FFFFAA 	    BGE  Loop2
 231              	Skip:
 232 0130 02A08AE2 	    ADD  r10, r10, #2               @;; increment the cache number
 233 0134 0A0053E1 	    CMP  r3, r10
 234 0138 E5FFFFCA 	    BGT  Loop1
 235              	
 236              	Finished:
 237              	
 238              	
 239              	@===================================================================
 240              	@ Enable MMU
 241              	@ Leaving the caches disabled until (main).
 242              	@===================================================================
 243 013c 100F11EE 	    MRC  p15, 0, r0, c1, c0, 0      @;; Read CP15 System Control register (SCTLR)
 244 0140 010AC0E3 	    BIC  r0, r0, #(0x1 << 12)       @;; Clear I bit 12 to disable I Cache
 245 0144 0400C0E3 	    BIC  r0, r0, #(0x1 <<  2)       @;; Clear C bit  2 to disable D Cache
 246 0148 0200C0E3 	    BIC  r0, r0, #0x2               @;; Clear A bit  1 to disable strict alignment fault checking
 247 014c 010080E3 	    ORR  r0, r0, #0x1               @;; Set M bit 1 to enable MMU before section initialization pro
 248 0150 100F01EE 	    MCR  p15, 0, r0, c1, c0, 0      @;; Write CP15 System Control register
 249              	
 250              	@===================================================================
 251              	@ copy and clear the sections
 252              	@===================================================================
 253 0154 60009FE5 	    LDR  r0, =DTBL                  @;; ROM to RAM table
 254 0158 60109FE5 	    LDR  r1, =BTBL                  @;; RAM zero fill table
 255 015c 38C09FE5 	    LDR  r12,=INITSCT               @;; Save this in register for possible long jump
 256 0160 3CFF2FE1 	    BLX  r12                        @;; Call to copy and to clear the sections
 257              	
 258              	@===================================================================
 259              	@ Call global constructors
 260              	@===================================================================
 261 0164 58C09FE5 	    LDR  r12,=__libc_init_array     @;; Save this in register for possible long jump
 262 0168 3CFF2FE1 	    BLX  r12                        @;; Call to global objects initializer
 263              	
 264              	@ =========================================================================
 265              	@ Branch to C library entry point
 266              	@ =========================================================================
 267 016c 54C09FE5 	    LDR  r12,=resetprg
 268 0170 1CFF2FE1 	    BX   r12                              /* Branch to C library entry point */
 269              	
 270              	
